<script>

/* USER DATA */

let memories =

  JSON.parse(

    localStorage.getItem("everafter_memories")

  ) || [];

let user =

  JSON.parse(

    localStorage.getItem("everafter_user")

  ) || null;

/* SIGNUP */

function openSignup() {

  document

    .getElementById("signupModal")

    .classList.add("active");

}

function closeSignup() {

  document

    .getElementById("signupModal")

    .classList.remove("active");

}

/* CREATE ACCOUNT */

function createAccount() {

  const name =

    document

      .getElementById("signupName")

      .value

      .trim();

  const email =

    document

      .getElementById("signupEmail")

      .value

      .trim();

  const password =

    document

      .getElementById("signupPassword")

      .value

      .trim();

  const purpose =

    document

      .getElementById("signupPurpose")

      .value;

  if (!name || !email || !password) {

    alert(

      "Please complete all required fields."

    );

    return;

  }

  user = {

    name: name,

    email: email,

    purpose: purpose,

    created:

      new Date().toISOString()

  };

  localStorage.setItem(

    "everafter_user",

    JSON.stringify(user)

  );

  closeSignup();

  showDashboard();

}

/* DASHBOARD */

function showDashboard() {

  document

    .getElementById("mainSite")

    .style.display = "none";

  document

    .getElementById("dashboard")

    .classList.add("active");

  document

    .getElementById("interview")

    .classList.remove("active");

  document

    .getElementById("mainNav")

    .style.display = "none";

  if (user) {

    document

      .getElementById("userName")

      .textContent = user.name;

  }

  updateProgress();

  window.scrollTo(0,0);

}

/* WEBSITE */

function showMainSite() {

  document

    .getElementById("mainSite")

    .style.display = "block";

  document

    .getElementById("dashboard")

    .classList.remove("active");

  document

    .getElementById("interview")

    .classList.remove("active");

  document

    .getElementById("mainNav")

    .style.display = "block";

  window.scrollTo(0,0);

}

/* INTERVIEW */

function openInterview() {

  document

    .getElementById("dashboard")

    .classList.remove("active");

  document

    .getElementById("mainSite")

    .style.display = "none";

  document

    .getElementById("mainNav")

    .style.display = "none";

  document

    .getElementById("interview")

    .classList.add("active");

  window.scrollTo(0,0);

}

function sendMemory() {

  const input =

    document

      .getElementById("memoryInput");

  const text =

    input.value.trim();

  if (!text) {

    alert(

      "Tell me a little about the memory first."

    );

    return;

  }

  memories.push({

    text: text,

    date:

      new Date().toLocaleDateString()

  });

  localStorage.setItem(

    "everafter_memories",

    JSON.stringify(memories)

  );

  const answer =

    document.getElementById("userAnswer");

  answer.textContent = text;

  answer.style.display = "block";

  document

    .getElementById("aiQuestion")

    .innerHTML = `

      <strong>EverAfter AI</strong>

      <p style="margin-top:8px">

        I want to remember that.

        Can you tell me a little more about what made

        that moment special to you?

      </p>

    `;

  input.value = "";

  updateProgress();

}

/* PROGRESS */

function updateProgress() {

  let progress = 15;

  if (memories.length > 0) {

    progress = 35;

  }

  if (memories.length > 2) {

    progress = 55;

  }

  if (memories.length > 5) {

    progress = 75;

  }

  if (memories.length > 10) {

    progress = 90;

  }

  document

    .getElementById("progressBar")

    .style.width = progress + "%";

  document

    .getElementById("progressText")

    .textContent = progress + "%";

}

/* MEMORY VAULT */

function showMemories() {

  const list =

    document.getElementById("memoryList");

  if (memories.length === 0) {

    list.innerHTML = `

      <p style="color:var(--gray)">

        You haven't saved any memories yet.

      </p>

    `;

  }

  else {

    list.innerHTML =

      memories.map(

        (memory,index) => `

          <div class="memory">

            <strong>

              Memory ${index + 1}

            </strong>

            <p style="margin-top:6px">

              ${escapeHTML(memory.text)}

            </p>

            <small style="color:var(--gray)">

              Added ${memory.date}

            </small>

          </div>

        `

      ).join("");

  }

  document

    .getElementById("memoryModal")

    .classList.add("active");

}

function closeMemory() {

  document

    .getElementById("memoryModal")

    .classList.remove("active");

}

